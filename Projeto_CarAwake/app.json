{
  "expo": {
    "name": "Car Awake",
    "slug": "car-awake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/carroawake.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/carroawake.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/carroawake.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.carawake.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/carroawake.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-audio"
    ]
  }
}
